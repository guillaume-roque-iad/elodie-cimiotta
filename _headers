# Working files are public resources, not search landing pages.
# Keep crawling allowed in robots.txt so engines can read this directive.
/seo/*
  X-Robots-Tag: noindex

/scripts/*
  X-Robots-Tag: noindex

/editorial/*
  X-Robots-Tag: noindex

# These font filenames carry an explicit version. Use a new filename when
# replacing their content; HTML and unversioned scripts keep their current cache.
/montserrat-home-v10.woff2
  Cache-Control: public, max-age=86400

/montserrat-latin-v8.woff2
  Cache-Control: public, max-age=86400

/montserrat-latin-v9.woff2
  Cache-Control: public, max-age=86400

/montserrat-title-v12.woff2
  Cache-Control: public, max-age=86400
